<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentruntime</groupId>
        <artifactId>agent-runtime-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>agent-runtime-spring-boot-starter</artifactId>
    <name>agent-runtime-spring-boot-starter</name>
    <description>聚合 + 自动装配：业务方只加这一个依赖，引擎/仓储/幂等/指标/span 自动就位</description>

    <dependencies>
        <dependency>
            <groupId>com.agentruntime</groupId>
            <artifactId>agent-runtime-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          spring-boot-autoconfigure 已经传递依赖 spring-boot → spring-core/beans/context/aop，
          所以只声明这一个就够；再逐个显式声明只会让将来升版本时多两处要改。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
          @Validated 配置校验需要 classpath 上有 jakarta.validation 实现，否则约束会被静默忽略
          （「配错了却不报错」比「启动失败」更危险）。starter-validation 很轻，直接非 optional 引入。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Micrometer / OTel 都是 optional：不引入也能跑（自动退化为 SimpleMetrics / NoopTracer），
          引入了才启用适配器。这是 DESIGN §11「@ConditionalOnClass 隔离」的落地方式——
          企业最怕的就是「为了用你一个库，顺手把自家的 tracing 版本也换掉了」。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          M9 运维端点。optional：不引 actuator 的应用不该被动获得一个 /actuator 依赖；
          引了才启用（@ConditionalOnClass 隔离）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Flyway 版本化迁移（P1）。optional：默认仍用 AgentSchemaInitializer 的幂等 DDL，
          生产想用 Flyway 时引入本依赖 + 设 agent.runtime.flyway.enabled=true 即可。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          测试要验「有 DataSource 走 JDBC」这条分支。用 H2 而不是 PostgreSQL：
          CI 不该依赖一个外部数据库；方言相关内容由 samples 的 PG 演示覆盖。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 自动装配的行为要能被断言；test 作用域不会传递给使用方 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
